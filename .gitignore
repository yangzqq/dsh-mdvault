node_modules/
*.log
.DS_Store

# Packaging artifacts (`npm pack`). The tarball is a build output, and the
# cache dir exists only so `npm pack` works when the default npm cache is not
# writable.
*.tgz
.npm-cache/

# Never commit a token file. Publishing needs a credential, and an .npmrc in
# the project root is the most common place for one to leak into a repository.
.npmrc
