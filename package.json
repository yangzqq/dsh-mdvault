{
  "name": "dsh-mdvault",
  "description": "Workspace document vault for the dsh web GUI: a conversation '文档' tab with an all-type file tree (Markdown/PDF/HTML/code/Excel·CSV/images), full GFM rendering via the platform MarkdownText (tables, task lists, footnotes, KaTeX math, highlighted code fences), Mermaid diagrams, Obsidian-style [[wikilinks]], PDF blob preview, image zoom/pan, native SheetJS spreadsheets, and in-page editing with find/replace. Optional dsh-better-sidebar viewer integration.",
  "version": "1.2.3",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "test": "node test/helpers.test.mjs && node test/host.test.mjs && node test/render.test.mjs",
    "test:helpers": "node test/helpers.test.mjs",
    "test:host": "node test/host.test.mjs",
    "test:render": "node test/render.test.mjs",
    "probe:graph": "node test/probe-graph.mjs",
    "verify:served": "node test/verify-served.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {},
  "files": [
    "lib",
    "dist",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-web",
    "deepseek-harness",
    "markdown",
    "obsidian",
    "wikilinks",
    "mermaid",
    "pdf",
    "spreadsheet",
    "document-viewer",
    "file-preview"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangzqq/dsh-mdvault.git"
  },
  "bugs": {
    "url": "https://github.com/yangzqq/dsh-mdvault/issues"
  },
  "homepage": "https://github.com/yangzqq/dsh-mdvault#readme",
  "author": "yangzqq",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
